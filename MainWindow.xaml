<Window x:Class="asd.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:asd"
        mc:Ignorable="d"
        Title="MainWindow" Height="1500" Width="800">
    <Window.Resources>
       
        <Style TargetType="Button" x:Key="login">
            <Setter Property="IsEnabled" Value="False"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text.Length, ElementName=jelszo}" Value="3">
                    <Setter Property="IsEnabled" Value="True"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Label" x:Key="darkMode">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontSize" Value="16"/>
            
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=darkModeCheckBox}" Value="True">
                    <Setter Property="Background" Value="DarkSlateGray"/>
                    <Setter Property="Foreground" Value="Pink"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>




        <Style TargetType="Label" x:Key="password">
            <Setter Property="Content" Value="Jelszo megadva"/>
            <Setter Property="Foreground" Value="Green"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>


            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, ElementName=jelszobeiro}" Value="">
                    <Setter Property="Content" Value="nem adtal meg jelszot"/>
                    <Setter Property="Foreground" Value="Red"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        

        <Style TargetType="Label" x:Key="copy">
            <Setter Property="Content" Value="{Binding Text,UpdateSourceTrigger=PropertyChanged, ElementName=copyWord}"/>

        </Style>



        
        <Style TargetType="Border" x:Key="greenBackgroundBorder">
            <Setter Property="Width" Value="250"/>
            <Setter Property="Height" Value="120"/>
            <Setter Property="Background" Value="LightGray"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=greenBackgroundCheckBox}" Value="True">
                    <Setter Property="Background" Value="LightGreen"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--7-->

        <Style TargetType="Button" x:Key="largeButton">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="16"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=largeButtonCheckBox}" Value="True">
                    <Setter Property="Width" Value="220"/>
                    <Setter Property="Height" Value="70"/>
                    <Setter Property="FontSize" Value="22"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>


        <!--8-->
        
        <Style TargetType="Label" x:Key="difficultyLabelStyle">
            <Setter Property="Content" Value="Válassz nehézségi szintet!"/>
            <Setter Property="FontSize" Value="23"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, ElementName=kezdoCombobox}" Value="True">
                    <Setter Property="Content" Value="Kezdő szint kiválasztva"/>
                    <Setter Property="Foreground" Value="Green"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, ElementName=haladoCombobox}" Value="True">
                    <Setter Property="Content" Value="Haladó szint kiválasztva"/>
                    <Setter Property="Foreground" Value="Orange"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, ElementName=profiCombobox}" Value="True">
                    <Setter Property="Content" Value="Profi szint kiválasztva"/>
                    <Setter Property="Foreground" Value="Red"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        
        
      

        <Style TargetType="Button" x:Key="continueButtonStyle">
            <Setter Property="IsEnabled" Value="True"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, ElementName=usernameTextBox}" Value="">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Text.Length, ElementName=usernameTextBox}" Value="1">
                    
                </DataTrigger>
            </Style.Triggers>
        </Style>



    </Window.Resources>
    <StackPanel>
        <CheckBox Content="szinvaltoztatas" x:Name="colorChanged"/>
       
        <TextBox x:Name="email"></TextBox>
        <Label Content="Nem toltotted ki az email mezőt"/>
        <TextBox x:Name="jelszo"></TextBox>
        <Button Content="Login" Style="{StaticResource login}"/>

        <CheckBox Content="Dark Mode" x:Name="darkModeCheckBox"/>
        <Label Content="hali" Style="{StaticResource darkMode}"/>
        <Label Content="sotetmode" Style="{StaticResource darkMode}"/>
        
        <TextBox x:Name="jelszobeiro" Width="200" Height="30"/>
        <Label Style="{StaticResource password}"/>
        
        
        <TextBox x:Name="copyWord" Width="200" Height="30"/>
        <Label Style="{StaticResource copy}"/>
        
        
        <Border Style="{StaticResource greenBackgroundBorder}">
            <CheckBox Content="Zöld háttér bekapcsolása" x:Name="greenBackgroundCheckBox"/>

        </Border>
        
        <CheckBox Content="Nagy gomb" x:Name="largeButtonCheckBox"/>
        <Button Content="Mentés" Style="{StaticResource largeButton}"/>
        
        <Label x:Name="difficultyLabel" Content="nehezsegi szint" Style="{StaticResource difficultyLabelStyle}"/>
        <ComboBox x:Name="difficultyComboBox" Width="200" Height="30" >
            <ComboBoxItem Content="Kezdő" x:Name="kezdoCombobox"/>
            <ComboBoxItem Content="Haladó" x:Name="haladoCombobox"/>
            <ComboBoxItem Content="Profi" x:Name="profiCombobox"/>
        </ComboBox>

        <TextBox x:Name="usernameTextBox"/>
        <Button Content="Tovább" Style="{StaticResource continueButtonStyle}"/>

    </StackPanel>
</Window>
